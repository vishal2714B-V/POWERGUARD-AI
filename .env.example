# PowerGuard AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for zero-config local run, PostgreSQL supported)
DATABASE_URL=sqlite:///./powerguard.db
# DATABASE_URL=postgresql://user:password@localhost:5432/powerguard_ai

# Energy & Tariff Constants
ENERGY_TARIFF=8.0
CO2_EMISSION_FACTOR=0.82
PENALTY_RATE=10.0
WASTAGE_THRESHOLD_KW=1.8

# Frontend URL
FRONTEND_URL=http://localhost:5173
